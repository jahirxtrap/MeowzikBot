# Copy this file to .env and fill in your values
DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id

# Path to the yt-dlp binary when it isn't on PATH
YTDLP_PATH=

# Datacenter IPs get "Sign in to confirm you're not a bot" from YouTube. Point this
# at a Netscape-format cookies.txt from a throwaway account; it is only used after
# YouTube actually asks, so a desktop run never touches it.
YTDLP_COOKIES=
YTDLP_COOKIES_FROM_BROWSER=

# Extra flags appended to every yt-dlp call, e.g.
# YTDLP_ARGS=--extractor-args "youtube:player_client=web_safari"
YTDLP_ARGS=

# Where a typed song name is searched: youtube (default) or soundcloud. Links always
# go to the site they point at, whichever this is.
SEARCH_SOURCE=
